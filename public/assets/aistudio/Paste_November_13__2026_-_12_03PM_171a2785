<!doctype html>
<html lang="hu">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; img-src data:; script-src 'unsafe-inline'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'">
<title>Nevelőszülői SJT – Hazudozás és szabályszegés</title>
<style>
:root{color-scheme:light;--ink:#192e2a;--green:#205648;--muted:#425b53;--line:#cad9d2;--paper:#fff;--wash:#f2f6f3}
*{box-sizing:border-box}
body{margin:0;background:var(--wash);color:var(--ink);font:1rem/1.55 "Segoe UI",sans-serif}
main{max-width:860px;margin:auto;padding:clamp(1rem,4vw,2.5rem)}
header,article,section.panel{background:var(--paper);border:1px solid var(--line);border-radius:18px;padding:clamp(1rem,4vw,2rem);margin-bottom:1rem}
header{background:#133c32;color:white;border:0}
.btesz-logo{display:block;width:135px;max-width:100%;height:auto;background:white;border-radius:6px;margin-bottom:1rem}
#participant-name{display:block;width:min(100%,32rem);margin:.35rem 0 0;padding:.55rem;border:1px solid var(--muted);border-radius:6px;font:inherit}
#result-name{overflow-wrap:anywhere}
h1,h2,h3,p{margin:0 0 .65rem}
h1{font:600 clamp(2rem,6vw,3.4rem)/1.08 Georgia,serif;letter-spacing:-.035em}
h2{font:600 clamp(1.4rem,4vw,1.85rem)/1.2 Georgia,serif}
h3{font-size:1.05rem}
.eyebrow{font-weight:700;letter-spacing:.08em;text-transform:uppercase;font-size:.8rem}
.notice{background:#fff3da;color:#533915;border-left:4px solid #9d661e;padding:.8rem 1rem;margin:.9rem 0}
.muted,small{color:var(--muted)}
summary{cursor:pointer;font-weight:650}
.progress{position:sticky;top:0;z-index:1;background:var(--wash);padding:.55rem 0 .85rem}
progress,meter{width:100%;height:.75rem;display:block;accent-color:var(--green)}
progress{margin-top:.25rem}
fieldset{margin:1rem 0 0;padding:.65rem;border:1px solid var(--line);border-radius:12px;min-width:0}
legend{font-weight:650;padding:0 .35rem}
.reaction{padding:.65rem .35rem;border-bottom:1px solid var(--line)}
.reaction:last-child{border-bottom:0}
.ratings{display:flex;flex-wrap:wrap;gap:.35rem 1rem}
.option{display:grid;grid-template-columns:1.1rem 1fr;gap:.5rem;padding:.5rem .35rem;border-radius:6px;cursor:pointer}
.option:has(input:checked){background:#e4f0e9}
.option:has(input:disabled){opacity:.65;cursor:default}
input[type=radio]{margin:.25rem 0 0;align-self:start;width:1rem;height:1rem;accent-color:var(--green)}
.choices{padding-left:1.8rem}
.choices li{padding:.25rem 0 .25rem .2rem}
.actions{display:flex;gap:.65rem;flex-wrap:wrap;margin:1rem 0}
button{font:inherit;font-weight:650;padding:.65rem 1rem;border:1px solid var(--green);border-radius:8px;background:var(--green);color:white;cursor:pointer}
button.secondary{background:white;color:var(--green)}
:focus-visible{outline:3px solid #a46415;outline-offset:3px}
article{scroll-margin-top:5rem}
.error{color:#962923;font-weight:650}
.score{font:600 3rem/1 Georgia,serif;color:var(--green);margin:1rem 0}
.profile{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:.7rem;margin:1rem 0}
.profile div{border:1px solid var(--line);border-radius:10px;padding:.75rem}
.review{padding-left:1.5rem}
.review li{margin-bottom:.65rem}
.print-note{display:none}
[hidden]{display:none!important}
@page{size:A4;margin:14mm}
@media print{
  body{background:white;color:black;font-size:10pt}
  main{max-width:none;padding:0}
  header,#intro,#test,.actions,noscript{display:none!important}
  .print-note{display:block}
  section.panel{padding:0;border:0}
  .profile div,.review li,.notice{break-inside:avoid}
  h2,h3{break-after:avoid}
  .score{font-size:24pt}
}
</style>
</head>
<body>
<main>
  <header>
    <img id="btesz-logo" class="btesz-logo" src="data:image/png;base64," width="270" height="148" alt="Baptista Tevékeny Szeretet Misszió">
    <p class="eyebrow">Nevelőszülői helyzetmegítélési teszt</p>
    <h1>Hazudozás és szabályszegés</h1>
    <p>10 helyzet nevelőszülői önreflexióhoz és képzéshez</p>
