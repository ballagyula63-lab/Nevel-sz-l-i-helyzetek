      "Gondoskodnék a másnapi felügyeletről, és leírnám, amit Eszter mondott. A hivatalos jelzéssel megvárnám a másnapi konzultációt.",
      "Nyugodtan meghallgatnám Esztert, és a gyermekvédelmi eljárásrend szerint jeleznék. A másnapi találkozó ügyében megvárnám a visszajelzést.",
      "Nyugodtan meghallgatnám Esztert, elmondanám neki, kinek kell szólnom, hogy segítséget kapjon, és feljegyezném a szavait. Haladéktalanul követném a gyermekvédelmi eljárásrendet, és az illetékesekkel azonnal gondoskodnék a biztonságos másnapi felügyeletről."
    ],
    "why": "A nyugodt meghallgatás, a pontos feljegyzés, a haladéktalan jelzés és az azonnali biztonságtervezés egymást kiegészítő lépések."
  }
];
const byId = id => document.getElementById(id);
const form = byId("test");
const participantName = byId("participant-name");
byId("report-logo").src = byId("btesz-logo").src;
participantName.addEventListener("input", () => {
  byId("name-error").textContent = "";
  participantName.removeAttribute("aria-invalid");
});
const results = byId("results");
const letters = "ABCD";
let answers;
let orders;
const worstKey = items.map(() => 0);

function worstPoints(i, rank) {
  return rank === worstKey[i] ? 3 : 0;
}

function shuffled() {
  const order = [0, 1, 2, 3];
  for (let i = order.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [order[i], order[j]] = [order[j], order[i]];
  }
  return order;
}

function renderItem(item, i) {
  const order = orders[i];
  const choices = `<fieldset><legend>Ön mit tenne ebben a helyzetben?</legend>${order.map((rank, position) =>
    `<div class="reaction"><p><strong>${letters[position]}.</strong> ${item.options[rank]}</p>
      <div class="ratings">${[["best","Legmegfelelőbb"],["worst","Legkevésbé megfelelő"]].map(([kind,label]) =>
        `<label class="option"><input type="radio" name="${kind}-${i}" value="${rank}" data-item="${i}" data-kind="${kind}" aria-label="${letters[position]}. ${label}"><span>${label}</span></label>`
      ).join("")}</div></div>`
  ).join("")}</fieldset>`;
  return `<article id="item-${i}" aria-labelledby="title-${i}">
    <h2 id="title-${i}" tabindex="-1">${i + 1}. ${item.title}</h2><p>${item.scene}</p>
    ${choices}
    </article>`;
}

function updateProgress() {
  const count = answers.filter(({best,worst}) => best !== null && worst !== null).length;
  byId("progress").value = count;
  byId("progress-label").textContent = `Kitöltött helyzetek ${count}/${items.length}`;
}

function start() {
  participantName.value = "";
  participantName.removeAttribute("aria-invalid");
  byId("name-error").textContent = "";
  answers = items.map(() => ({best:null,worst:null}));
  orders = items.map(shuffled);
  byId("items").innerHTML = items.map(renderItem).join("");
  byId("report").replaceChildren();
  byId("error").textContent = "";
  results.hidden = true;
  form.hidden = false;
  updateProgress();
}

form.addEventListener("change", event => {
  const input = event.target;
  if (!input.matches('input[type="radio"]')) return;
  const i = Number(input.dataset.item);
  const answer = answers[i];
  answer[input.dataset.kind] = Number(input.value);
  byId(`item-${i}`).querySelectorAll("input").forEach(radio => {
    const other = radio.dataset.kind === "best" ? "worst" : "best";
    radio.disabled = Number(radio.value) === answer[other];
  });
  byId("error").textContent = "";
  updateProgress();
});

function renderReport() {
  const profile = competencies.map(area => ({...area, score:0, max:0}));
  const scores = answers.map(({best,worst}, i) => {
    const points = best * 2 + worstPoints(i, worst);
    profile[items[i].area].score += points;
    profile[items[i].area].max += 9;
    return points;
  });
  const total = scores.reduce((sum, points) => sum + points, 0);
  const priorities = profile.filter(area => area.score < area.max)
    .sort((a, b) => a.score / a.max - b.score / b.max).slice(0, 2);
  const safety = scores[7] < 9 || scores[9] < 9;
  const date = new Intl.DateTimeFormat("hu-HU", {dateStyle:"long"}).format(new Date());
  const describe = (i, rank) => `${letters[orders[i].indexOf(rank)]}. ${items[i].options[rank]}`;
  byId("report").innerHTML = `
    <p><strong>Kitöltési azonosító</strong> · <span id="result-name"></span></p>
    <p class="muted">Kitöltés dátuma: ${date}</p>
    <p class="score">${total} / 90 pont</p>
    <p class="notice"><strong>Nem validált teszt. Önálló kiválasztási vagy alkalmassági döntésre nem alkalmas.</strong> Az eredmény azt mutatja, mennyire egyeznek a válaszok az előzetes szakmai kulccsal. Nincs megfelelési küszöb vagy összehasonlítási norma.</p>
    <h3>Kompetenciaprofil</h3>
    <p class="muted">A részpontszámok területenként 2–3 helyzetből állnak össze.</p>
    <div class="profile">${profile.map(area => `<div><strong>${area.name}</strong>
      <p>${area.score} / ${area.max} pont</p>
      <meter aria-label="${area.name}" min="0" max="${area.max}" value="${area.score}"></meter>
    </div>`).join("")}</div>
    <h3>Fejlesztési visszajelzés</h3>
    ${safety ? '<p class="notice"><strong>Beszélje át a 8. és a 10. helyzetet szakmai konzultáción.</strong> Gyakorolja a közvetlen veszély megszakítását és a bántalmazásról szóló közlésre adott első lépéseket.</p>' : ""}
    ${priorities.length ? `<ul>${priorities.map(area => `<li><strong>${area.name}.</strong> ${area.practice}</li>`).join("")}</ul>`
      : "<p>Minden választása egyezett a kulccsal. Képzésen gyakorolja, hogyan mondaná el a gyermeknek a választott reakció első mondatát, és mi lenne a következő lépése.</p>"}
    <h3>Visszajelzés helyzetenként</h3>
    <ol class="review">${items.map((item, i) => `<li>
      <strong>${item.title} · ${scores[i]}/9 pont</strong><br>
      Legmegfelelőbbnek jelölte (${answers[i].best * 2}/6 pont): ${describe(i, answers[i].best)}<br>
      Legkevésbé megfelelőnek jelölte (${worstPoints(i, answers[i].worst)}/3 pont): ${describe(i, answers[i].worst)}<br>
      ${answers[i].worst !== worstKey[i] ? `<strong>A kulcs szerinti legkevésbé megfelelő:</strong> ${describe(i, worstKey[i])}<br>` : ""}
      ${answers[i].best !== 3 ? `<strong>A kulcs szerinti legmegfelelőbb:</strong> ${describe(i, 3)}<br>` : ""}
      ${item.why}</li>`).join("")}</ol>
    <h3>Pontozás</h3>
    <p>A legmegfelelőbbnek jelölt reakció 0, 2, 4 vagy 6 pontot ér a szakmai kulcs szerint. A kulcs szerinti legkevésbé megfelelő reakció felismerése további 3 pontot ér, minden más jelölés ebben a kategóriában 0 pontot. Helyzetenként legfeljebb 9, összesen 90 pont szerezhető.</p>
    <p class="muted">A tételek és a kulcs saját fejlesztésűek. A szemlélethez felhasznált háttéranyagok az NCTSN nevelőszülői tananyaga és az NSPCC útmutatója a bántalmazásról szóló közlések fogadásához.</p>`;
  byId("result-name").textContent = participantName.value.trim();
}

form.addEventListener("submit", event => {
  event.preventDefault();
  if (!participantName.value.trim()) {
    byId("name-error").textContent = "Adja meg a kitöltő nevét.";
    participantName.setAttribute("aria-invalid", "true");
    participantName.focus();
    return;
  }
  const missing = answers.findIndex(({best,worst}) => best === null || worst === null || best === worst);
  if (missing !== -1) {
    const message = `A(z) ${missing + 1}. helyzetben jelölje meg a legmegfelelőbb és a legkevésbé megfelelő reakciót.`;
    byId("error").textContent = message;
    byId(`title-${missing}`).focus();
    return;
  }
  renderReport();
  form.hidden = true;
  results.hidden = false;
  byId("result-title").focus();
});

byId("print").addEventListener("click", () => window.print());
byId("edit").addEventListener("click", () => {
  results.hidden = true;
  form.hidden = false;
  byId("title-0").focus();
});
byId("restart").addEventListener("click", () => {
  if (!window.confirm("Törli a jelenlegi válaszokat, és új kitöltést indít?")) return;
  start();
  byId("title-0").focus();
});
start();
</script>
</body>
</html>
